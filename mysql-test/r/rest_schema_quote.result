DROP DATABASE IF EXISTS `rest'q`;
CREATE DATABASE `rest'q`;
CREATE FUNCTION `rest'q`.add_numbers(a INT, b INT) RETURNS INT DETERMINISTIC RETURN a + b;
CREATE PROCEDURE `rest'q`.noop(IN x INT)
BEGIN
DO x;
END//
INSTALL EXTENSION vsql_rest;
SET GLOBAL vsql_rest.schema = 'rest''q';
SET GLOBAL vsql_rest.vsql_rest_enabled = ON;
