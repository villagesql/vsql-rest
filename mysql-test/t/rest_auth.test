--source rest_setup.inc

SET GLOBAL vsql_rest.jwt_secret = 'test-secret-key';
SET GLOBAL vsql_rest.require_auth = ON;
SET @orig_sql_mode = @@GLOBAL.sql_mode;
--sleep 0.3

# C36: No Authorization header → 401.
--exec curl -s -o /dev/null -w "%{http_code}" "http://localhost:$REST_PORT/customers"
--echo ""

# C37: Valid HS256 JWT → 200.
--exec REST_PORT=$REST_PORT python3 $MYSQL_TEST_DIR/suite/vsql-rest/t/rest_jwt_helper.py valid_200

# C38: Expired JWT → 401.
--exec REST_PORT=$REST_PORT python3 $MYSQL_TEST_DIR/suite/vsql-rest/t/rest_jwt_helper.py expired_401

# C38b: JWT with no exp claim → 401 (must not be accepted forever).
--exec REST_PORT=$REST_PORT python3 $MYSQL_TEST_DIR/suite/vsql-rest/t/rest_jwt_helper.py noexp_401

# C40: JWT sub injected as @vsql_rest_jwt_sub; view filters by it.
# MySQL views cannot use user variables directly; a helper function is required.
--disable_warnings
DROP FUNCTION IF EXISTS test_rest.vsql_rest_jwt_sub;
DROP VIEW IF EXISTS test_rest.owned;
--enable_warnings
delimiter //;
CREATE FUNCTION test_rest.vsql_rest_jwt_sub() RETURNS VARCHAR(255)
NOT DETERMINISTIC READS SQL DATA
BEGIN RETURN @vsql_rest_jwt_sub; END//
delimiter ;//
CREATE VIEW test_rest.owned AS
    SELECT * FROM test_rest.customers
    WHERE email = test_rest.vsql_rest_jwt_sub();

# Wait for schema cache TTL (2s in test mode) to expire so view is visible.
--sleep 2.5

--exec REST_PORT=$REST_PORT python3 $MYSQL_TEST_DIR/suite/vsql-rest/t/rest_jwt_helper.py view_filter

# C38c: the auth scheme is case-insensitive per RFC 9110.
--exec REST_PORT=$REST_PORT python3 $MYSQL_TEST_DIR/suite/vsql-rest/t/rest_jwt_helper.py lowercase_bearer_200

# C38d: a 401 carries a WWW-Authenticate challenge.
--exec curl -s -D - -o /dev/null "http://localhost:$REST_PORT/customers" | grep -i "^www-authenticate:" | tr -d '\r'

# C41: a claim name that is not an identifier is not interpolated into SQL.
# "a = 1, GLOBAL sql_mode" would otherwise extend the SET statement; the
# request must still succeed, with the claim simply skipped.
--exec REST_PORT=$REST_PORT python3 $MYSQL_TEST_DIR/suite/vsql-rest/t/rest_jwt_helper.py hostile_claim_name
--echo # sql_mode unchanged by the hostile claim name:
SELECT @@GLOBAL.sql_mode = @orig_sql_mode AS sql_mode_intact;

SET GLOBAL vsql_rest.require_auth = OFF;

# C42: with auth optional, an anonymous request must not inherit the claims of
# an authenticated one sharing the same SQL session.
DROP FUNCTION IF EXISTS test_rest.whoami;
CREATE FUNCTION test_rest.whoami() RETURNS VARCHAR(255)
NOT DETERMINISTIC READS SQL DATA
RETURN COALESCE(@vsql_rest_jwt_sub, 'NONE');
--sleep 2.5
--exec REST_PORT=$REST_PORT python3 $MYSQL_TEST_DIR/suite/vsql-rest/t/rest_jwt_helper.py no_claim_leak

--source rest_teardown.inc
