--source rest_setup.inc

# A client that never finishes its request must not park a connection thread
# inside the server forever. Each accepted connection gets its own detached
# thread, so an unfinished request is a held thread. Both cases here send a
# request line and never terminate the headers, which is what a slow-loris
# client does.

--write_file $MYSQLTEST_VARDIR/tmp/rest_halfopen.py
import os, socket, subprocess, sys, time

PORT     = int(os.environ['REST_PORT'])
DEADLINE = int(os.environ['DEADLINE'])
TMP      = os.environ['REST_TMP']
READY    = os.path.join(TMP, 'parked.ready')
DONE     = os.path.join(TMP, 'parked.done')
LOG      = os.path.join(TMP, 'halfopen.log')

def log(msg):
    with open(LOG, 'a') as f:
        f.write('%s\n' % msg)

def half_open():
    """Connect and send an unterminated request. Returns the live socket."""
    s = socket.create_connection(('127.0.0.1', PORT), timeout=10)
    s.sendall(b'GET /customers HTTP/1.1\r\nHost: localhost\r\n')
    return s

action = sys.argv[1]

if action == 'closed_within_deadline':
    # Dribble a header line every few seconds and never terminate the headers.
    # A per-read socket timeout alone cannot stop this: every write resets the
    # gap it measures. Only a deadline on the request as a whole ends it.
    s = half_open()
    start = time.time()
    limit = DEADLINE * 2
    try:
        while time.time() - start < limit:
            time.sleep(DEADLINE / 4.0)
            s.sendall(b'X-Pad: y\r\n')
        print('STILL DRIPPING after %ds - deadline does not bound the request'
              % limit)
    except Exception:
        print('closed by server within deadline')
    s.close()

elif action == 'park_launcher':
    # Foreground launcher: spawn the parked connection in a detached child and
    # do not return until the child reports it is connected. MTR blocks on this
    # exec, so the connection is established before the next test line runs.
    for stale in (READY, DONE):
        if os.path.exists(stale):
            os.remove(stale)
    child = subprocess.Popen([sys.executable, __file__, 'park_child'],
                             start_new_session=True,
                             stdout=subprocess.DEVNULL,
                             stderr=subprocess.STDOUT)
    for _ in range(200):          # 20s ceiling
        if os.path.exists(READY):
            sys.exit(0)
        if child.poll() is not None:
            break
        time.sleep(0.1)
    sys.stderr.write('parked connection never became ready; child log:\n')
    if os.path.exists(LOG):
        sys.stderr.write(open(LOG).read())
    sys.exit(1)

elif action == 'park_child':
    # Park a connection, then complete the request after the test has disabled
    # the extension underneath it. The connection thread then walks into the
    # request queue, which the disable has already torn down.
    watchdog = time.time() + 120   # self-exit so a skipped cleanup cannot leak
    try:
        s = half_open()
        log('connected')
        with open(READY, 'w') as f:
            f.write('parked\n')
        while time.time() < watchdog and not os.path.exists(
                os.path.join(TMP, 'parked.go')):
            time.sleep(0.1)
        s.sendall(b'\r\n')
        log('request completed after disable')
        s.settimeout(5)
        try:
            s.recv(4096)
        except Exception as e:
            log('recv after disable: %s' % e)
        s.close()
    except Exception as e:
        log('child failed: %s' % e)
    finally:
        # Last write of the run. park_reap waits for this, so the test's
        # cleanup cannot race the log() calls above.
        with open(DONE, 'w') as f:
            f.write('done\n')

elif action == 'park_reap':
    # Wait for the detached child to finish writing. Its recv() blocks for
    # seconds after parked.go is written, and every log() call recreates
    # halfopen.log -- so removing the file before the child is done leaves a
    # stray file behind and MTR's check-testcase fails the test.
    for _ in range(600):          # 60s ceiling, well above the child's recv
        if os.path.exists(DONE):
            sys.exit(0)
        time.sleep(0.1)
    sys.stderr.write('parked child never finished; child log:\n')
    if os.path.exists(LOG):
        sys.stderr.write(open(LOG).read())
    sys.exit(1)
EOF

--echo # Case 1: a client that drags out a request is disconnected.
--exec REST_PORT=$REST_PORT DEADLINE=20 REST_TMP=$MYSQLTEST_VARDIR/tmp python3 $MYSQLTEST_VARDIR/tmp/rest_halfopen.py closed_within_deadline

--echo # Case 2: disabling the extension under a parked connection is clean.
--exec REST_PORT=$REST_PORT DEADLINE=20 REST_TMP=$MYSQLTEST_VARDIR/tmp python3 $MYSQLTEST_VARDIR/tmp/rest_halfopen.py park_launcher

SET GLOBAL vsql_rest.vsql_rest_enabled = OFF;

# Release the parked child so it completes its request against the torn-down
# queue. Under ASan, a use-after-free in the connection thread aborts here.
--write_file $MYSQLTEST_VARDIR/tmp/parked.go
go
EOF

# Wait for the child to finish rather than sleeping a fixed interval: it holds
# the connection open for its recv() timeout, and the assertions below are only
# meaningful once it has completed the request against the torn-down queue.
--exec REST_PORT=$REST_PORT DEADLINE=20 REST_TMP=$MYSQLTEST_VARDIR/tmp python3 $MYSQLTEST_VARDIR/tmp/rest_halfopen.py park_reap

--echo # Server survived the disable:
SELECT 1 AS alive;

--echo # And still serves requests after re-enabling:
SET GLOBAL vsql_rest.vsql_rest_enabled = ON;
--source rest_wait_http.inc
--exec curl -s -o /dev/null -w "%{http_code}" "http://localhost:$REST_PORT/customers"
--echo ""

--remove_file $MYSQLTEST_VARDIR/tmp/rest_halfopen.py
--remove_file $MYSQLTEST_VARDIR/tmp/parked.ready
--remove_file $MYSQLTEST_VARDIR/tmp/parked.go
--remove_file $MYSQLTEST_VARDIR/tmp/parked.done
--remove_file $MYSQLTEST_VARDIR/tmp/halfopen.log

--source rest_teardown.inc
