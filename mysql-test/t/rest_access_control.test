--source rest_setup.inc

# ============================================================
# allowed_tables: restrict which tables are reachable
# ============================================================

# Default: all tables reachable.
--exec curl -s -o /dev/null -w "%{http_code}" "http://localhost:$REST_PORT/customers"
--echo ""
--exec curl -s -o /dev/null -w "%{http_code}" "http://localhost:$REST_PORT/orders"
--echo ""

# Restrict to customers only.
SET GLOBAL vsql_rest.allowed_tables = 'customers';
--sleep 0.2

# customers is still reachable.
--exec curl -s -o /dev/null -w "%{http_code}" "http://localhost:$REST_PORT/customers"
--echo ""

# orders returns 404 (not leaked).
--exec curl -s -o /dev/null -w "%{http_code}" "http://localhost:$REST_PORT/orders"
--echo ""
--exec curl -s "http://localhost:$REST_PORT/orders" | python3 -c "import sys,json; d=json.load(sys.stdin); print('message' in d)"

# Discovery only lists allowed tables.
--exec curl -s "http://localhost:$REST_PORT/" | python3 -c "import sys,json; d=json.load(sys.stdin); tables=list(d['definitions'].keys()); print('customers' in tables, 'orders' in tables)"

# Reset allowlist.
SET GLOBAL vsql_rest.allowed_tables = '';
--sleep 0.2

# orders is reachable again.
--exec curl -s -o /dev/null -w "%{http_code}" "http://localhost:$REST_PORT/orders"
--echo ""

# ============================================================
# table_methods: restrict HTTP methods per table
# ============================================================

# customers: GET only. orders: GET and POST.
SET GLOBAL vsql_rest.table_methods = 'customers:GET|orders:GET,POST';
--sleep 0.2

# Allowed methods succeed.
--exec curl -s -o /dev/null -w "%{http_code}" "http://localhost:$REST_PORT/customers"
--echo ""
--exec curl -s -o /dev/null -w "%{http_code}" "http://localhost:$REST_PORT/orders"
--echo ""

# POST to customers → 405.
--exec curl -s -o /dev/null -w "%{http_code}" -X POST -H "Content-Type: application/json" -d '{"name":"Dave","email":"dave@example.com","age":30}' "http://localhost:$REST_PORT/customers"
--echo ""
--exec curl -s -X POST -H "Content-Type: application/json" -d '{"name":"Dave","email":"dave@example.com","age":30}' "http://localhost:$REST_PORT/customers" | python3 -c "import sys,json; d=json.load(sys.stdin); print('message' in d)"

# DELETE on orders → 405 (not in the allowed set).
--exec curl -s -o /dev/null -w "%{http_code}" -X DELETE "http://localhost:$REST_PORT/orders?id=eq.1"
--echo ""

# POST to orders is allowed (GET,POST).
--exec curl -s -o /dev/null -w "%{http_code}" -X POST -H "Content-Type: application/json" -d '{"customer_id":1,"total":10.00,"status":"pending"}' "http://localhost:$REST_PORT/orders"
--echo ""

# Reset method restrictions.
SET GLOBAL vsql_rest.table_methods = '';
--sleep 0.2

# POST to customers allowed again.
--exec curl -s -o /dev/null -w "%{http_code}" -X POST -H "Content-Type: application/json" -d '{"name":"Dave","email":"dave@example.com","age":30}' "http://localhost:$REST_PORT/customers"
--echo ""

# ============================================================
# Combined: allowlist + method restrictions
# ============================================================

SET GLOBAL vsql_rest.allowed_tables = 'customers';
SET GLOBAL vsql_rest.table_methods = 'customers:GET';
--sleep 0.2

# orders not in allowlist → 404.
--exec curl -s -o /dev/null -w "%{http_code}" "http://localhost:$REST_PORT/orders"
--echo ""

# customers GET allowed.
--exec curl -s -o /dev/null -w "%{http_code}" "http://localhost:$REST_PORT/customers"
--echo ""

# customers POST blocked by method restriction → 405.
--exec curl -s -o /dev/null -w "%{http_code}" -X POST -H "Content-Type: application/json" -d '{"name":"Eve","email":"eve@example.com","age":22}' "http://localhost:$REST_PORT/customers"
--echo ""

# Reset.
SET GLOBAL vsql_rest.allowed_tables = '';
SET GLOBAL vsql_rest.table_methods = '';

# ============================================================
# allowed_routines: restrict which /rpc/ endpoints are callable
# ============================================================

# Default: all routines callable.
--exec curl -s -o /dev/null -w "%{http_code}" -X POST -H "Content-Type: application/json" -d '{"a":3,"b":4}' "http://localhost:$REST_PORT/rpc/add_numbers"
--echo ""

# Restrict to add_numbers only — mark_shipped is blocked.
SET GLOBAL vsql_rest.allowed_routines = 'add_numbers';
--sleep 0.2

# add_numbers is still callable.
--exec curl -s -o /dev/null -w "%{http_code}" -X POST -H "Content-Type: application/json" -d '{"a":3,"b":4}' "http://localhost:$REST_PORT/rpc/add_numbers"
--echo ""

# mark_shipped returns 404 (not leaked).
--exec curl -s -o /dev/null -w "%{http_code}" -X POST -H "Content-Type: application/json" -d '{"order_id":1}' "http://localhost:$REST_PORT/rpc/mark_shipped"
--echo ""
--exec curl -s -X POST -H "Content-Type: application/json" -d '{"order_id":1}' "http://localhost:$REST_PORT/rpc/mark_shipped" | python3 -c "import sys,json; d=json.load(sys.stdin); print('message' in d)"

# Reset.
SET GLOBAL vsql_rest.allowed_routines = '';
--sleep 0.2

# mark_shipped callable again.
--exec curl -s -o /dev/null -w "%{http_code}" -X POST -H "Content-Type: application/json" -d '{"order_id":1}' "http://localhost:$REST_PORT/rpc/mark_shipped"
--echo ""

--source rest_teardown.inc
