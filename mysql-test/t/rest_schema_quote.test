# A schema name containing a single quote must still expose its routines.
--disable_warnings
DROP DATABASE IF EXISTS `rest'q`;
--enable_warnings
CREATE DATABASE `rest'q`;
CREATE FUNCTION `rest'q`.add_numbers(a INT, b INT) RETURNS INT DETERMINISTIC RETURN a + b;
delimiter //;
CREATE PROCEDURE `rest'q`.noop(IN x INT)
BEGIN
  DO x;
END//
delimiter ;//

INSTALL EXTENSION vsql_rest;
--disable_query_log
SET GLOBAL vsql_rest.port = 0;
--enable_query_log
SET GLOBAL vsql_rest.schema = 'rest''q';
SET GLOBAL vsql_rest.vsql_rest_enabled = ON;
--source rest_wait_http.inc

--exec curl -s -X POST -H "Content-Type: application/json" -d '{"a":7,"b":5}' "http://localhost:$REST_PORT/rpc/add_numbers"
--echo ""
--exec curl -s -o /dev/null -w "%{http_code}" -X POST -H "Content-Type: application/json" -d '{"x":1}' "http://localhost:$REST_PORT/rpc/noop"
--echo ""

SET GLOBAL vsql_rest.vsql_rest_enabled = OFF;
--sleep 0.5
UNINSTALL EXTENSION vsql_rest;
DROP DATABASE `rest'q`;
