--source rest_setup.inc

# C41 + C42: HTTPS on ssl_port, HTTP on port still work simultaneously.
# Self-signed cert is generated per-test under MYSQL_TMP_DIR so concurrent
# workers can't clobber a shared cert path.

--exec openssl req -x509 -newkey rsa:2048 -keyout $MYSQL_TMP_DIR/vsql_rest_test.key -out $MYSQL_TMP_DIR/vsql_rest_test.crt -days 1 -nodes -subj "/CN=localhost" 2>/dev/null && echo "cert generated"

--disable_query_log
--eval SET GLOBAL vsql_rest.ssl_cert = '$MYSQL_TMP_DIR/vsql_rest_test.crt'
--eval SET GLOBAL vsql_rest.ssl_key  = '$MYSQL_TMP_DIR/vsql_rest_test.key'
SET GLOBAL vsql_rest.ssl_port = 0;
--enable_query_log
SET GLOBAL vsql_rest.vsql_rest_enabled = OFF;
--sleep 0.5
SET GLOBAL vsql_rest.vsql_rest_enabled = ON;
# Re-enable rebinds both listeners to fresh OS-assigned ports — rediscover.
--source rest_wait_http.inc
--source rest_wait_https.inc

# C41: HTTPS responds 200 (self-signed, skip verify with -k).
--exec curl -sk -o /dev/null -w "%{http_code}" "https://localhost:$REST_SSL_PORT/customers"
--echo ""

# C42: HTTP still responds 200 with both listeners active.
--exec curl -s -o /dev/null -w "%{http_code}" "http://localhost:$REST_PORT/customers"
--echo ""

SET GLOBAL vsql_rest.ssl_cert = '';
SET GLOBAL vsql_rest.ssl_key  = '';

--remove_file $MYSQL_TMP_DIR/vsql_rest_test.crt
--remove_file $MYSQL_TMP_DIR/vsql_rest_test.key

--source rest_teardown.inc
