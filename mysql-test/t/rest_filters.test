--source rest_setup.inc

# C3: GET all rows returns JSON array of 3.
--exec curl -s "http://localhost:18080/customers" | python3 -c "import sys,json; d=json.load(sys.stdin); print(len(d), sorted(d[0].keys()))"

# C4: eq filter returns 1 row.
--exec curl -s "http://localhost:18080/customers?name=eq.Alice" | python3 -c "import sys,json; d=json.load(sys.stdin); print(len(d), d[0]['name'])"

# C5: neq filter returns 2 rows.
--exec curl -s "http://localhost:18080/customers?name=neq.Alice" | python3 -c "import sys,json; d=json.load(sys.stdin); print(len(d))"

# C6: numeric comparisons.
--exec curl -s "http://localhost:18080/customers?age=gt.30" | python3 -c "import sys,json; d=json.load(sys.stdin); print(len(d))"
--exec curl -s "http://localhost:18080/customers?age=gte.35" | python3 -c "import sys,json; d=json.load(sys.stdin); print(len(d))"
--exec curl -s "http://localhost:18080/customers?age=lt.35" | python3 -c "import sys,json; d=json.load(sys.stdin); print(len(d))"
--exec curl -s "http://localhost:18080/customers?age=lte.25" | python3 -c "import sys,json; d=json.load(sys.stdin); print(len(d))"

# C7: like with MySQL % wildcard (URL-encoded as %25).
--exec curl -s "http://localhost:18080/customers?name=like.A%25" | python3 -c "import sys,json; d=json.load(sys.stdin); print(len(d), d[0]['name'])"

# C8: cs_like (LIKE BINARY) - case sensitive.
--exec curl -s "http://localhost:18080/customers?name=cs_like.A%25" | python3 -c "import sys,json; d=json.load(sys.stdin); print(len(d))"
--exec curl -s "http://localhost:18080/customers?name=cs_like.a%25" | python3 -c "import sys,json; d=json.load(sys.stdin); print(len(d))"

# C9: in operator.
--exec curl -s "http://localhost:18080/customers?id=in.(1,3)" | python3 -c "import sys,json; d=json.load(sys.stdin); print(len(d), sorted([r['name'] for r in d]))"

# C11: or() combines filters with OR.
--exec curl -s "http://localhost:18080/customers?or=(name.eq.Alice,name.eq.Bob)" | python3 -c "import sys,json; d=json.load(sys.stdin); print(len(d), sorted([r['name'] for r in d]))"

# C12: multiple params are AND-combined.
--exec curl -s "http://localhost:18080/customers?age=gt.30&name=like.B%25" | python3 -c "import sys,json; d=json.load(sys.stdin); print(len(d), d[0]['name'])"

# C13: no matches returns empty array.
--exec curl -s "http://localhost:18080/customers?name=eq.nobody" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d)"

# C10: is.null and is.not.null filters.
UPDATE test_rest.customers SET age = NULL WHERE id = 3;
--exec curl -s "http://localhost:18080/customers?age=is.null" | python3 -c "import sys,json; d=json.load(sys.stdin); print(len(d), d[0]['name'])"
--exec curl -s "http://localhost:18080/customers?age=is.not.null" | python3 -c "import sys,json; d=json.load(sys.stdin); print(len(d))"
UPDATE test_rest.customers SET age = 45 WHERE id = 3;

--source rest_teardown.inc
